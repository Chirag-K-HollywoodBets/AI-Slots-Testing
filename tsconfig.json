{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/agent/**/*.ts",
    "tests/agent/**/*.ts",
    "tests/agent-ai-demo.e2e.ts",
    "tests/agent-browser.e2e.ts",
    "tests/agent-live-sports.e2e.ts",
    "tests/agent-slot.e2e.ts",
    "tests/setup/**/*.ts",
    "tests/diagnostics/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".e2e"
  ]
}